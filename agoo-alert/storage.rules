rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Images de rapports (existant)
    match /reports/{reportId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Médias des messages liés aux rapports
    match /reports/{reportId}/messages/{path=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Médias des conversations (chat après acceptation)
    match /conversations/{conversationId}/messages/{path=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Documents de vérification (NOUVEAU - accès restreint)
    // Tous les fichiers selfie_*.jpg dans /verification/{userId}/
    match /verification/{userId}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.moderator == true
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Logos d'organisations
    match /organizations/logos/{fileName} {
      allow read: if true; // Logos publics
      allow write: if request.auth != null; // Tout utilisateur connecté peut uploader
    }

    // Documents de vérification d'organisations
    match /organizations/documents/{fileName} {
      allow read: if request.auth != null && request.auth.token.moderator == true;
      allow write: if request.auth != null;
    }

    // Règle catch-all pour debugging (à supprimer en production)
    match /organizations/{path=**} {
      allow read, write: if request.auth != null;
    }
  }
}
