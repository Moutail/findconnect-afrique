# Configuration du serveur
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/agoo-alert
# Ou utiliser MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/agoo-alert

# JWT Secret - Générer une clé secrète forte
JWT_SECRET=votre_cle_secrete_tres_longue_et_complexe_ici
JWT_EXPIRES_IN=7d

# Upload de fichiers
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# URL du frontend (pour CORS)
FRONTEND_URL=http://localhost:8081

# Email (optionnel - pour les notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASS=votre_mot_de_passe_app
