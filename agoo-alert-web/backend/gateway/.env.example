PORT=5000
NODE_ENV=development

# URLs des microservices
AUTH_SERVICE_URL=http://localhost:5001
USER_SERVICE_URL=http://localhost:5002
PUBLICATION_SERVICE_URL=http://localhost:5003
CHAT_SERVICE_URL=http://localhost:5004
UPLOAD_SERVICE_URL=http://localhost:5005
ADMIN_SERVICE_URL=http://localhost:5006

# CORS
CORS_ORIGINS=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Groq API pour le chatbot d'aide (https://console.groq.com/keys)
GROQ_API_KEY=
